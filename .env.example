# docker compose 실행 설정 예시다. 서버에서는 scripts/install.sh가 이 파일로 .env를 만든다.
# .env에는 API 키가 들어가므로 저장소·번들에 넣지 않는다(권한 600).

# OpenAI(STT·LLM)를 쓰는 경우 필수다. 로컬 모델 프로필만 쓰면 비워 둔다.
OPENAI_API_KEY=

# 배포 번들 설치 시 scripts/install.sh가 채운다. 개발 PC에서는 비워 두면 local 태그를 쓴다.
# N_NOTE_IMAGE_TAG=
# Docker volume 이름의 접두어다. 버전을 바꿔도 같은 값을 써야 초안·이력이 이어진다.
# COMPOSE_PROJECT_NAME=n-note

# 실환자 운영 권장값
# N_NOTE_REQUIRE_LOCAL_STT=true
# N_NOTE_REQUIRE_AUTHENTICATED_USER=true

# 표준국어 사전은 korean 이미지에 들어 있다. 다른 릴리스는 개발 PC에서 빌드할 때 고른다(서버 설정 아님).
# KODICT_RELEASE=2026.10

# 로컬 모델 가중치 캐시 위치(scripts/download_models.sh로 받은 디렉터리). 폐쇄망은 HF_HUB_OFFLINE=1
# N_NOTE_MODEL_CACHE=/opt/n-note/model-cache
# HF_HUB_OFFLINE=1

# LLM 호출 계층: native(기본, OpenAI SDK 직접) 또는 pydantic_ai(Pydantic AI Agent).
# 같은 지침·스키마·도구 상한을 쓰므로 eval(run_model_eval)로 비교한 뒤 바꾼다.
# N_NOTE_LLM_ENGINE=native

# 프롬프트는 src/n_note_ai_service_layers/prompts/prompts.toml 한 파일에 있다. 다른 파일로 실험할 때만 지정한다.
# N_NOTE_PROMPTS_FILE=/app/prompts/experiment.toml

# OpenTelemetry 추적(OTLP/HTTP). 개발·평가 화면은 docker-compose.observability.yml(Phoenix)이 대신 켠다.
# N_NOTE_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# 프롬프트·LLM 응답·도구 인자를 span에 남긴다. 실환자 데이터 환경에서는 켜지 않는다.
# N_NOTE_OTEL_CAPTURE_CONTENT=false

# 추적 화면(Arize Phoenix). 번들을 scripts/bundle.sh --with-observability 로 만들었을 때만 해당한다.
# install.sh가 아래 비밀값 3개를 만들어 이 파일에 넣고 Phoenix를 함께 띄운다. 직접 넣어도 된다(각 32자 이상 권장).
# 개발 PC에서 docker-compose.observability.yml을 직접 쓸 때는 직접 채운다:
#   python3 -c "import secrets;print(secrets.token_urlsafe(36))"
# 띄우지 않으려면 false로 두고 ./scripts/install.sh --skip-load 로 다시 기동한다.
# N_NOTE_OBSERVABILITY=true
# 세션·토큰 서명 키다. 한 번 정하면 바꾸지 않는다(바꾸면 로그인 세션·API 키가 무효가 된다).
# PHOENIX_SECRET=
# ai-service가 추적을 보낼 때 쓰는 인증 값이다(Authorization: Bearer).
# PHOENIX_ADMIN_SECRET=
# 화면 첫 로그인(admin@localhost) 비밀번호다. Phoenix가 처음 기동할 때만 쓰이고, 이후에는 화면에서 바꾼 값이 남는다.
# PHOENIX_ADMIN_PASSWORD=
# 화면 포트. 서버의 127.0.0.1에만 연다. 다른 PC에서는 ssh -L 6006:127.0.0.1:6006 <서버> 로 접속한다.
# PHOENIX_BIND_ADDRESS=127.0.0.1
# PHOENIX_PORT=6006
# 화면의 프로젝트 이름(서버·환경별로 나눠 보려면 바꾼다).
# PHOENIX_PROJECT=n-note
# install.sh가 Phoenix를 띄울 때 적는다. 이후 docker compose ps·logs·down도 Phoenix를 포함한다.
# COMPOSE_FILE=docker-compose.yml:docker-compose.observability.yml
