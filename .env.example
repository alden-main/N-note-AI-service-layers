# docker compose 실행 설정 예시다. 서버에서는 scripts/install.sh가 이 파일로 .env를 만든다.
# .env에는 API 키가 들어가므로 저장소·번들에 넣지 않는다(권한 600).

# OpenAI(STT·LLM)를 쓰는 경우 필수다. 로컬 모델 프로필만 쓰면 비워 둔다.
OPENAI_API_KEY=

# 배포 번들 설치 시 scripts/install.sh가 채운다. 개발 PC에서는 비워 두면 local 태그를 쓴다.
# N_NOTE_IMAGE_TAG=
# Docker volume 이름의 접두어다. 버전을 바꿔도 같은 값을 써야 초안·이력이 이어진다.
# COMPOSE_PROJECT_NAME=n-note

# 실환자 운영 권장값
# N_NOTE_REQUIRE_LOCAL_STT=true
# N_NOTE_REQUIRE_AUTHENTICATED_USER=true

# 표준국어 사전은 kodict 이미지에 들어 있다. 다른 릴리스는 개발 PC에서 빌드할 때 고른다(서버 설정 아님).
# KODICT_RELEASE=2026.10

# 로컬 모델 가중치 캐시 위치(scripts/download_models.sh로 받은 디렉터리). 폐쇄망은 HF_HUB_OFFLINE=1
# N_NOTE_MODEL_CACHE=/opt/n-note/model-cache
# HF_HUB_OFFLINE=1
