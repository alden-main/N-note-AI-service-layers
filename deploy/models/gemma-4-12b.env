# Gemma 4 12B (Apache 2.0, dense 약 12B, 2026.06). bf16 약 24GB로 A100 40GB에서 Whisper와 함께 적재한다.
# - 이미지·오디오 입력을 받는 모델이지만 초안 생성은 텍스트만 쓰므로 멀티모달 입력을 0으로 막아 메모리를 아낀다.
# - 실측 전 프로필이다: OOM이면 --max-model-len을 8192로 줄이거나 --quantization fp8(가중치 약 12GB)을 더한다.
#   scripts/smoke-test.sh gemma-4-12b 로 적재·KV cache·지연 시간을 확인한다.
# - thinking은 끈다(chat_template_kwargs). tool call은 vLLM gemma4 parser 검증 전이라 끈다(용어 검토 힌트만 사용).
N_NOTE_MODEL_PROFILE=gemma-4-12b
N_NOTE_COMPOSE_PROFILES=local-stt,local-llm
# --- 로컬 STT: Whisper large-v3-turbo (약 1.6GB, A100 40GB의 10%) ---
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
N_NOTE_REQUIRE_LOCAL_STT=true
# --- 로컬 LLM: Gemma 4 12B (GPU 메모리 80%: 가중치 약 24GB + KV cache) ---
N_NOTE_LOCAL_LLM_MODEL=google/gemma-4-12B-it
N_NOTE_LOCAL_LLM_ARGS=--max-model-len 16384 --gpu-memory-utilization 0.80 --limit-mm-per-prompt.image 0 --limit-mm-per-prompt.audio 0
N_NOTE_LLM_MODEL=gemma-4-12b
N_NOTE_LLM_BASE_URL=http://local-llm:8000/v1
N_NOTE_LLM_API=chat
N_NOTE_LLM_MAX_TOKENS=2048
N_NOTE_LLM_TEMPERATURE=0.2
N_NOTE_LLM_TOOL_CALLING=false
N_NOTE_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
