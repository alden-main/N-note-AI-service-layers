# Gemma 4 26B-A4B (Apache 2.0, MoE: 활성 약 4B라 빠르다). bf16 약 52GB라 FP8 가중치 양자화로 적재한다.
# - 실험 프로필: A100(Ampere)에서 MoE FP8 weight-only 동작과 메모리는 실측이 필요하다.
#   실패하면 80GB GPU에서 bf16으로 돌리거나 int4 체크포인트를 쓴다.
# - tool call은 vLLM gemma4 parser와 전용 chat template이 필요해 기본은 끈다.
N_NOTE_MODEL_PROFILE=gemma-4-26b-a4b
N_NOTE_COMPOSE_PROFILES=local-stt,local-llm
# --- 로컬 STT: Whisper large-v3-turbo (약 1.6GB, A100 40GB의 10%) ---
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
N_NOTE_LOCAL_LLM_MODEL=google/gemma-4-26B-A4B-it
N_NOTE_LOCAL_LLM_ARGS=--quantization fp8 --max-model-len 8192 --gpu-memory-utilization 0.85 --limit-mm-per-prompt.image 0
N_NOTE_LLM_MODEL=gemma-4-26b-a4b
N_NOTE_LLM_BASE_URL=http://local-llm:8000/v1
N_NOTE_LLM_API=chat
N_NOTE_LLM_MAX_TOKENS=2048
N_NOTE_LLM_TEMPERATURE=0.2
N_NOTE_LLM_TOOL_CALLING=false
