# Qwen3.5 9B (Apache 2.0, 다국어). bf16 약 19GB로 A100 40GB에서 STT와 여유 있게 함께 돈다.
# - 공식 tool parser(qwen3_coder)로 Gateway 사전 도구 호출을 켠다.
# - 초안 생성은 지연시간이 중요하므로 thinking을 끈다(N_NOTE_LLM_EXTRA_BODY).
N_NOTE_MODEL_PROFILE=qwen3.5-9b
N_NOTE_COMPOSE_PROFILES=local-stt,local-llm
# --- 로컬 STT: Whisper large-v3-turbo (약 1.6GB, A100 40GB의 10%) ---
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
N_NOTE_LOCAL_LLM_MODEL=Qwen/Qwen3.5-9B
N_NOTE_LOCAL_LLM_ARGS=--max-model-len 16384 --gpu-memory-utilization 0.80 --language-model-only --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder
N_NOTE_LLM_MODEL=qwen3.5-9b
N_NOTE_LLM_BASE_URL=http://local-llm:8000/v1
N_NOTE_LLM_API=chat
N_NOTE_LLM_MAX_TOKENS=2048
N_NOTE_LLM_TEMPERATURE=0.2
N_NOTE_LLM_TOOL_CALLING=true
N_NOTE_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
