# MedGemma 1.5 4B (Gemma 3 기반 의료 특화, 멀티모달 4B). bf16 약 9GB.
# - Hugging Face에서 이용 약관 동의가 필요한 gated 모델이다(HF_TOKEN).
# - tool call을 지원하지 않아 사전 도구 없이 전사문 용어 검토 힌트만으로 초안을 만든다.
N_NOTE_MODEL_PROFILE=medgemma-1.5-4b
N_NOTE_COMPOSE_PROFILES=local-stt,local-llm
# --- 로컬 STT: Whisper large-v3-turbo (약 1.6GB, A100 40GB의 10%) ---
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
N_NOTE_LOCAL_LLM_MODEL=google/medgemma-1.5-4b-it
N_NOTE_LOCAL_LLM_ARGS=--max-model-len 16384 --gpu-memory-utilization 0.60 --limit-mm-per-prompt.image 0
N_NOTE_LLM_MODEL=medgemma-1.5-4b
N_NOTE_LLM_BASE_URL=http://local-llm:8000/v1
N_NOTE_LLM_API=chat
N_NOTE_LLM_MAX_TOKENS=2048
N_NOTE_LLM_TEMPERATURE=0.2
N_NOTE_LLM_TOOL_CALLING=false
