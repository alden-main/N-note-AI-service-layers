# MedGemma 27B text (Gemma 3 27B 기반 의료 특화, 텍스트 전용).
# - bf16은 약 54GB라 A100 40GB에 올라가지 않는다. vLLM 기동 시 FP8 가중치 양자화(Ampere에서는
#   weight-only)로 약 28GB에 적재한다. 변환 중 bf16 가중치를 읽으므로 호스트 RAM 64GB 이상이 필요하다.
# - KV cache 여유가 약 5GB라 max-model-len 8192, 동시 요청 소수 기준이다. 실측 후 조정한다.
# - gated 모델(HF_TOKEN), tool call 미지원.
N_NOTE_MODEL_PROFILE=medgemma-27b
N_NOTE_COMPOSE_PROFILES=local-stt,local-llm
# --- 로컬 STT: Whisper large-v3-turbo (약 1.6GB, A100 40GB의 10%) ---
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
N_NOTE_LOCAL_LLM_MODEL=google/medgemma-27b-text-it
N_NOTE_LOCAL_LLM_ARGS=--quantization fp8 --max-model-len 8192 --gpu-memory-utilization 0.85
N_NOTE_LLM_MODEL=medgemma-27b
N_NOTE_LLM_BASE_URL=http://local-llm:8000/v1
N_NOTE_LLM_API=chat
N_NOTE_LLM_MAX_TOKENS=2048
N_NOTE_LLM_TEMPERATURE=0.2
N_NOTE_LLM_TOOL_CALLING=false
