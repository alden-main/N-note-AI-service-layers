# STT 전용: 로컬 Whisper large-v3-turbo (MIT, 약 0.8B, fp16 약 1.6GB)만 띄운다. LLM 서버는 띄우지 않는다.
# - STT 품질·속도(전사, 녹음 세션 청크 전사, WAV 변환·VAD)를 LLM과 분리해 확인할 때 쓴다.
#   scripts/smoke-test.sh whisper-large-v3-turbo --stt-only
# - 초안 생성까지 확인하려면 .env에 OPENAI_API_KEY를 두면 LLM은 OpenAI(gpt-4o-mini)를 쓴다(혼합 구성).
# - GPU 메모리는 LLM 프로필과 같은 10%로 둬 같은 GPU를 나눠 쓸 때와 같은 조건으로 잰다.
#   STT만 따로 운영한다면 N_NOTE_LOCAL_STT_GPU_UTIL을 높여 동시 처리량을 늘릴 수 있다.
N_NOTE_MODEL_PROFILE=whisper-large-v3-turbo
N_NOTE_COMPOSE_PROFILES=local-stt
N_NOTE_STT_BASE_URL=http://local-stt:8000/v1
N_NOTE_STT_MODEL=whisper-large-v3-turbo
N_NOTE_LOCAL_STT_MODEL=openai/whisper-large-v3-turbo
N_NOTE_LOCAL_STT_GPU_UTIL=0.10
# 원본 음성이 외부 OpenAI로 나가지 않게 로컬 STT만 허용한다.
N_NOTE_REQUIRE_LOCAL_STT=true
N_NOTE_LLM_MODEL=gpt-4o-mini
N_NOTE_LLM_API=responses
N_NOTE_LLM_TOOL_CALLING=true
